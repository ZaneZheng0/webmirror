{
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720,
    "deviceScaleFactor": 1
  },
  "sourceSettleMs": 18000,
  "loopbackSettleMs": 18000,
  "actionSettleMs": 3000,
  "actions": [
    {
      "id": "start-experience",
      "type": "click",
      "selector": "a.start-experience",
      "settleMs": 4000,
      "expectSelector": "#animalchanger.crow"
    },
    {
      "id": "next-animal",
      "type": "click",
      "selector": "ul.animal-nav li.next > a",
      "settleMs": 3500,
      "expectSelector": "#animalchanger.vaquita"
    },
    {
      "id": "open-threat",
      "type": "click",
      "selector": "a.why-endangered",
      "settleMs": 3000,
      "expectSelector": "body.smash"
    }
  ]
}
